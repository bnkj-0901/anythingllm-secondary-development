# Copy to .env before starting the local knowledge base.
# Do not put production secrets in this file or in git.
SERVER_PORT=3001
STORAGE_DIR=/app/server/storage
UID=1000
GID=1000
SIG_KEY=__GENERATE_SIG_KEY__
SIG_SALT=__GENERATE_SIG_SALT__
JWT_SECRET=__GENERATE_JWT_SECRET__
DISABLE_TELEMETRY=true
DISABLE_SWAGGER_DOCS=true
TARGET_OCR_LANG=chi_sim,eng
VECTOR_DB=lancedb

# Configure these in the local .env only when a provider is available.
# LLM_PROVIDER=generic-openai
# GENERIC_OPEN_AI_BASE_PATH=https://your-provider.example/v1
# GENERIC_OPEN_AI_API_KEY=replace-me
# GENERIC_OPEN_AI_MODEL_PREF=replace-me
# EMBEDDING_ENGINE=ollama
# EMBEDDING_BASE_PATH=http://host.docker.internal:11434
# EMBEDDING_MODEL_PREF=nomic-embed-text:latest
