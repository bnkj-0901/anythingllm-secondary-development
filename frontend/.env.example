# Use the current origin so the proxy preserves the enterprise Host.
VITE_API_BASE='/api'
# VITE_API_BASE='http://localhost:3001/api' # Direct local Server access
# VITE_API_BASE="https://$CODESPACE_NAME-3001.$GITHUB_CODESPACES_PORT_FORWARDING_DOMAIN/api" # for GitHub Codespaces
# Development Vite forwards /api to 127.0.0.1:3001 while preserving Host.
# Open the enterprise URL supplied by the platform (e.g. http://acme.localhost:3000).
# Production serves the browser and /api behind the same HTTPS host.
