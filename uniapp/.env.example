# Each tenant mini-program is built/deployed with its fixed enterprise API URL.
# Configure the tenant hostname before building; the login page accepts only credentials.
# /enterprise is added by the client. Stored endpoint values never override this setting.
# VITE_API_BASE=https://acme.saas.example.com/api
# Local WeChat tools: VITE_API_BASE=http://acme.localhost:3001/api
# H5 can omit VITE_API_BASE or use /api to call the current tenant page origin.
# VITE_API_BASE=/api
# VITE_API_PROXY_TARGET=http://127.0.0.1:3001
# Mini-programs without a valid configured URL fail closed and ask for administrator help.
# Real devices require reachable HTTPS and WeChat request/uploadFile domain allowlists.
