generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Only the shared settings modules and current SaaS business models are deployed.
model system_settings {
  id            Int      @id @default(autoincrement())
  label         String   @unique
  value         String?
  createdAt     DateTime @default(now())
  lastUpdatedAt DateTime @default(now())
}

model event_logs {
  id         Int      @id @default(autoincrement())
  event      String
  metadata   String?
  userId     String?
  occurredAt DateTime @default(now())

  @@index([event])
  @@index([userId])
}

model system_prompt_variables {
  id          Int      @id @default(autoincrement())
  key         String   @unique
  value       String?
  description String?
  type        String   @default("system") // system, user, dynamic
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model ep_tenants {
  id            String              @id
  code          String              @unique
  name          String
  hostname      String              @unique
  status        String              @default("active")
  createdAt     String
  updatedAt     String
  users         users[]
  connections   ep_connections[]
  libraries     ep_libraries[]
  libraryGrants ep_library_grants[]
  documents     documents[]
  threads       chat_threads[]
  ragSettings   ep_rag_settings?
  promptHistory prompt_history[]
}

model users {
  id                           Int                          @id @default(autoincrement())
  tenantId                     String
  username                     String
  name                         String
  passwordHash                 String
  wechatIdentity               String?
  wechatRegistrationComplete   Boolean                      @default(true)
  role                         String                       @default("user")
  pfpFilename                  String?
  bio                          String?                      @default("")
  seen_recovery_codes          Boolean?                     @default(false)
  web_push_subscription_config String?
  dailyMessageLimit            Int?
  status                       String                       @default("active")
  authVersion                  Int                          @default(1)
  createdAt                    DateTime                     @default(now())
  updatedAt                    DateTime                     @default(now()) @map("lastUpdatedAt")
  tenant                       ep_tenants                   @relation(fields: [tenantId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  libraryGrants                ep_library_grants[]
  threads                      chat_threads[]
  browser_extension_api_keys   browser_extension_api_keys[]
  desktop_mobile_devices       desktop_mobile_devices[]
  temporary_auth_tokens        temporary_auth_tokens[]
  recovery_codes               recovery_codes[]
  password_reset_tokens        password_reset_tokens[]

  @@unique([tenantId, username])
  @@unique([tenantId, wechatIdentity])
  @@unique([tenantId, id])
}

model recovery_codes {
  id        Int      @id @default(autoincrement())
  user_id   Int
  code_hash String
  createdAt DateTime @default(now())
  user      users    @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id])
}

model password_reset_tokens {
  id        Int      @id @default(autoincrement())
  user_id   Int
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      users    @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id])
}

model ep_platform_accounts {
  id           String @id
  username     String @unique
  name         String
  passwordHash String
  status       String @default("active")
  authVersion  Int    @default(1)
  createdAt    String
  updatedAt    String
}

model ep_connections {
  id        String      @id
  tenantId  String?
  scope     String
  kind      String
  provider  String
  name      String
  model     String
  baseUrl   String      @default("")
  secret    String?
  options   String      @default("{}")
  version   Int         @default(1)
  available Int         @default(1)
  isDefault Int         @default(0)
  createdAt String
  updatedAt String
  tenant    ep_tenants? @relation(fields: [tenantId], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model ep_rag_settings {
  tenantId  String     @id
  settings  String     @default("{}")
  updatedAt String
  tenant    ep_tenants @relation(fields: [tenantId], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model ep_libraries {
  id        String              @id
  tenantId  String
  name      String
  createdBy String
  createdAt String
  updatedAt String
  tenant    ep_tenants          @relation(fields: [tenantId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  documents documents[]
  grants    ep_library_grants[]

  @@unique([tenantId, id])
  @@index([tenantId], map: "ep_libraries_scope")
}

// A resource grant targets either all users of a tenant or one individual user.
// The database CHECK enforces exactly one subject; origin tenant is not access.
model ep_library_grants {
  id        String       @id
  libraryId String
  tenantId  String?
  userId    Int?
  library   ep_libraries @relation(fields: [libraryId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  tenant    ep_tenants?  @relation(fields: [tenantId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  user      users?       @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([libraryId, tenantId])
  @@unique([libraryId, userId])
  @@index([tenantId])
  @@index([userId])
}

model documents {
  id           String                @id
  tenantId     String
  libraryId    String
  title        String
  inputType    String
  content      String                @default("")
  metadata     String?
  pinned       Boolean               @default(false)
  originalPath String?
  status       String
  error        String?
  version      Int                   @default(1)
  embeddingId  String?
  createdBy    String
  updatedBy    String
  createdAt    String
  updatedAt    String
  tenant       ep_tenants            @relation(fields: [tenantId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  library      ep_libraries          @relation(fields: [tenantId, libraryId], references: [tenantId, id], onDelete: NoAction, onUpdate: NoAction)
  chunks       document_vectors[]
  syncQueue    document_sync_queues?

  @@unique([tenantId, id])
  @@index([tenantId, libraryId, status], map: "ep_documents_scope")
  @@map("ep_documents")
}

model document_vectors {
  id          String    @id
  tenantId    String
  documentId  String
  version     Int
  position    Int
  metadata    String?
  content     String
  embeddingId String
  dimensions  Int
  namespace   String
  document    documents @relation(fields: [tenantId, documentId], references: [tenantId, id], onDelete: NoAction, onUpdate: NoAction)

  @@index([tenantId, documentId, version, embeddingId], map: "ep_chunks_document")
  @@map("ep_chunks")
}

model ep_vector_settings {
  id        String  @id
  provider  String  @default("lancedb")
  config    String?
  revision  Int     @default(1)
  updatedAt String
}

model ep_vector_cleanup {
  id        String @id
  tenantId  String
  namespace String
  createdAt String
}

model ep_file_cleanup {
  path      String @id
  tenantId  String
  createdAt String
}

model chat_threads {
  id            Int        @id @default(autoincrement())
  tenantId      String
  userId        Int
  name          String
  slug          String     @unique
  createdAt     DateTime   @default(now())
  lastUpdatedAt DateTime   @default(now())
  tenant        ep_tenants @relation(fields: [tenantId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  user          users      @relation(fields: [tenantId, userId], references: [tenantId, id], onDelete: NoAction, onUpdate: NoAction)
  chats         chats[]

  @@unique([tenantId, userId, id])
  @@index([tenantId, userId, lastUpdatedAt])
}

model chats {
  id Int @id @default(autoincrement())

  tenantId        String
  userId          Int
  thread_id       Int
  prompt          String
  response        String
  include         Boolean      @default(true)
  api_session_id  String?
  feedbackScore   Boolean?
  memoryProcessed Boolean?     @map("memory_processed")
  createdAt       DateTime     @default(now())
  lastUpdatedAt   DateTime     @default(now())
  thread          chat_threads @relation(fields: [tenantId, userId, thread_id], references: [tenantId, userId, id], onDelete: NoAction, onUpdate: NoAction)

  @@index([tenantId, userId, thread_id, id])
}

model ep_knowledge_changes {
  id            String  @id
  tenantId      String
  libraryId     String?
  documentId    String?
  action        String
  payload       String  @default("{}")
  baseVersion   Int?
  baseUpdatedAt String?
  status        String  @default("pending")
  requestedBy   String
  reviewedBy    String?
  reviewNote    String?
  createdAt     String
  updatedAt     String
  reviewedAt    String?

  @@index([tenantId, status, createdAt])
  @@index([requestedBy, createdAt])
}

model memories {
  id         Int       @id @default(autoincrement())
  tenantId   String
  userId     Int       @map("user_id")
  content    String
  lastUsedAt DateTime? @map("last_used_at")
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @default(now()) @map("updated_at")

  @@index([tenantId, userId])
}

model workspace_agent_invocations {
  id            Int      @id @default(autoincrement())
  uuid          String   @unique
  prompt        String
  closed        Boolean  @default(false)
  tenantId      String
  user_id       Int
  thread_id     Int
  createdAt     DateTime @default(now())
  lastUpdatedAt DateTime @default(now())

  @@index([tenantId, user_id, thread_id])
}

model slash_command_presets {
  id            Int      @id @default(autoincrement())
  command       String
  prompt        String
  description   String
  tenantId      String
  userId        Int
  createdAt     DateTime @default(now())
  lastUpdatedAt DateTime @default(now())

  @@unique([tenantId, userId, command])
}

model model_routers {
  id                Int                  @id @default(autoincrement())
  name              String               @unique
  description       String?
  fallback_provider String
  fallback_model    String
  cooldown_seconds  Int                  @default(30)
  created_by        String?
  createdAt         DateTime             @default(now())
  lastUpdatedAt     DateTime             @default(now())
  rules             model_router_rules[]
}

model model_router_rules {
  id              Int           @id @default(autoincrement())
  router_id       Int
  enabled         Boolean       @default(true)
  priority        Int
  type            String        @default("calculated")
  title           String
  description     String?
  // For `calculated` rules: the boolean operator joining `conditions` — "AND"
  // (all must match) or "OR" (any must match). Null for `llm` rules.
  condition_logic String?
  // For `calculated` rules: JSON-stringified array of condition objects, each
  // shaped as { property: string, comparator: string, value: string } where
  // `property` ∈ VALID_PROPERTIES and `comparator` ∈ VALID_COMPARATORS (see
  // server/models/modelRouterRule.js). `value` is always stored as a string;
  // numeric comparators parse it at evaluation time. Null for `llm` rules.
  conditions      String?
  route_provider  String
  route_model     String
  created_by      String?
  createdAt       DateTime      @default(now())
  lastUpdatedAt   DateTime      @default(now())
  router          model_routers @relation(fields: [router_id], references: [id], onDelete: Cascade)

  @@unique([router_id, title])
  @@index([router_id])
  @@index([router_id, enabled, priority])
}

model cache_data {
  id            Int       @id @default(autoincrement())
  name          String
  data          String
  belongsTo     String?
  byId          Int?
  expiresAt     DateTime?
  createdAt     DateTime  @default(now())
  lastUpdatedAt DateTime  @default(now())
}

model api_keys {
  id            Int      @id @default(autoincrement())
  tenantId      String
  userId        Int
  name          String?
  secret        String?  @unique
  createdBy     String?
  createdAt     DateTime @default(now())
  lastUpdatedAt DateTime @default(now())
}

model browser_extension_api_keys {
  id            Int      @id @default(autoincrement())
  key           String   @unique
  tenantId      String
  user_id       Int
  createdAt     DateTime @default(now())
  lastUpdatedAt DateTime @updatedAt
  user          users    @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id])
}

model desktop_mobile_devices {
  id         Int      @id @default(autoincrement())
  deviceOs   String
  deviceName String
  token      String   @unique
  approved   Boolean  @default(false)
  tenantId   String
  userId     Int
  createdAt  DateTime @default(now())
  user       users    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model embed_configs {
  id                         Int           @id @default(autoincrement())
  uuid                       String        @unique
  enabled                    Boolean       @default(false)
  chat_mode                  String        @default("query")
  allowlist_domains          String?
  allow_model_override       Boolean       @default(false)
  allow_temperature_override Boolean       @default(false)
  allow_prompt_override      Boolean       @default(false)
  max_chats_per_day          Int?
  max_chats_per_session      Int?
  message_limit              Int?          @default(20)
  tenantId                   String
  libraryId                  String
  createdBy                  String?
  createdAt                  DateTime      @default(now())
  embed_chats                embed_chats[]
}

model embed_chats {
  id                     Int           @id @default(autoincrement())
  prompt                 String
  response               String
  session_id             String
  include                Boolean       @default(true)
  connection_information String?
  embed_id               Int
  createdAt              DateTime      @default(now())
  embed_config           embed_configs @relation(fields: [embed_id], references: [id], onDelete: Cascade)
}

model external_communication_connectors {
  id            Int      @id @default(autoincrement())
  tenantId      String
  botId         String?  @unique
  type          String
  config        String   @default("{}")
  active        Boolean  @default(false)
  createdAt     DateTime @default(now())
  lastUpdatedAt DateTime @default(now())

  @@unique([tenantId, type])
}

model scheduled_jobs {
  id        Int                  @id @default(autoincrement())
  tenantId  String
  userId    Int
  name      String
  prompt    String
  tools     String? // JSON array of tool identifiers (null = use all enabled agent skills)
  schedule  String // Cron expression
  enabled   Boolean              @default(true)
  lastRunAt DateTime?
  nextRunAt DateTime?
  createdAt DateTime             @default(now())
  updatedAt DateTime             @default(now())
  runs      scheduled_job_runs[]
}

model scheduled_job_runs {
  id          Int            @id @default(autoincrement())
  jobId       Int
  status      String         @default("queued") // queued | running | completed | failed | timed_out — model always sets explicitly
  result      String? // JSON execution trace
  error       String?
  startedAt   DateTime       @default(now())
  completedAt DateTime?
  readAt      DateTime? // null = unread
  job         scheduled_jobs @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([jobId])
}

model temporary_auth_tokens {
  id          Int      @id @default(autoincrement())
  token       String   @unique
  tenantId    String
  userId      Int
  authVersion Int      @default(1)
  expiresAt   DateTime
  createdAt   DateTime @default(now())
  user        users    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([token])
  @@index([userId])
}

model workspace_parsed_files {
  id                 Int      @id @default(autoincrement())
  tenantId           String
  userId             Int
  threadId           Int
  filename           String
  metadata           String?
  tokenCountEstimate Int      @default(0)
  createdAt          DateTime @default(now())
  lastUpdatedAt      DateTime @default(now())

  @@index([tenantId, userId, threadId])
}

model document_sync_queues {
  id             Int                        @id @default(autoincrement())
  documentId     String                     @unique
  tenantId       String
  userId         Int
  staleAfterMs   Int                        @default(604800000)
  nextSyncAt     DateTime
  lastSyncedAt   DateTime?
  failedAttempts Int                        @default(0)
  createdAt      DateTime                   @default(now())
  updatedAt      DateTime                   @default(now())
  document       documents                  @relation(fields: [documentId], references: [id], onDelete: Cascade)
  runs           document_sync_executions[]
}

model document_sync_executions {
  id        Int                  @id @default(autoincrement())
  queueId   Int
  status    String               @default("unknown")
  result    String?
  createdAt DateTime             @default(now())
  queue     document_sync_queues @relation(fields: [queueId], references: [id], onDelete: Cascade)
}

model prompt_history {
  id         Int        @id @default(autoincrement())
  tenantId   String
  prompt     String
  modifiedBy String?
  modifiedAt DateTime   @default(now())
  tenant     ep_tenants @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
}

model suggested_messages {
  id            Int      @id @default(autoincrement())
  tenantId      String
  heading       String
  message       String
  createdAt     DateTime @default(now())
  lastUpdatedAt DateTime @default(now())

  @@index([tenantId])
}
