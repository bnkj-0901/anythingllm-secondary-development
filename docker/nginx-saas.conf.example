# Include in nginx's http context. Configure DNS and TLS for your actual domains.
upstream anythingllm_api {
    # Compose publishes APP_PORT=3000 by default; bare server uses port 3001.
    server 127.0.0.1:3000;
}

# Reject unknown hosts before forwarding to the application.
server {
    listen 80 default_server;
    server_name _;
    return 444;
}

server {
    listen 80;
    server_name admin.example.com *.saas.example.com customer.example.org;
    client_max_body_size 1g;

    location / {
        proxy_pass http://anythingllm_api;
        # SaaS routing reads this Host and looks up ep_tenants.hostname.
        # Do not replace Host with the upstream address or a client-supplied header.
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_buffering off;
        proxy_read_timeout 300s;
    }
}
